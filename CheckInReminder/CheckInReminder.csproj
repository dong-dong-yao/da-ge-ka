<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.2.0-preview.7</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>打个卡</AssemblyName>
    <Product>打个卡</Product>
    <Title>打个卡</Title>
    <ApplicationIcon>Assets\Dagaka.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Dagaka.ico" LogicalName="CheckInReminder.Dagaka.ico" />
    <EmbeddedResource Include="Assets\Animations\**\*.png" />
    <EmbeddedResource Include="Assets\DesktopPet\**\*.jpg" />
    <EmbeddedResource Include="Assets\DesktopPet\**\*.png" />
    <EmbeddedResource Include="Assets\MediaTools\tools.zip" LogicalName="CheckInReminder.MediaTools.zip" Condition="Exists('Assets\MediaTools\tools.zip')" />
    <EmbeddedResource Include="Assets\CreationGuide\pose-reference.jpg" LogicalName="CheckInReminder.CreationGuide.pose-reference.jpg" />
    <EmbeddedResource Include="Assets\CreationGuide\three-view-example.png" LogicalName="CheckInReminder.CreationGuide.three-view-example.png" />
    <EmbeddedResource Include="..\THIRD_PARTY_NOTICES.md" LogicalName="CheckInReminder.THIRD_PARTY_NOTICES.md" />
  </ItemGroup>

  <Target Name="RequireBundledMediaToolsForPublish" BeforeTargets="Publish">
    <Error Condition="!Exists('Assets\MediaTools\tools.zip')" Text="完整发行版必须包含本地视频处理组件，请先运行 tools/pack-media-tools.ps1。" />
  </Target>

</Project>
